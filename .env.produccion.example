# =============================================================================
# Despliegue en la red de la empresa con Docker Compose.
# Copie este archivo como .env EN EL SERVIDOR y complete los valores.
# Este archivo contiene contrasenas: no lo suba al repositorio.
# =============================================================================

# --- Base de datos (contenedor interno, no expuesto a la red) ----------------
POSTGRES_DB=cofinet_facturas
POSTGRES_USER=cofinet
# Genere una contrasena larga y guardela en el gestor de claves de Sistemas.
POSTGRES_PASSWORD=

# --- Aplicacion --------------------------------------------------------------
# Puerto del servidor por el que la gente entra desde la red.
PUERTO=8080

# Direccion con la que se entra desde la red interna. Use el nombre DNS del
# servidor si lo tiene; si no, su IP fija.
#   http://facturas.cofinet.local:8080
#   http://192.168.1.50:8080
APP_URL=http://192.168.1.50:8080

# Firma la cookie de sesion. Generela con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Inicio de sesion --------------------------------------------------------
# local -> usuario y contrasena guardados en esta base de datos. Es lo que
#          funciona sin HTTPS y sin salida a internet. Recomendado por ahora.
# entra -> Microsoft 365 (exige HTTPS y que el servidor alcance internet).
# ambos -> se ofrecen las dos.
AUTH_MODE=local

# Correos que entran como ADMIN aunque la tabla aprobadores este vacia.
ADMIN_EMAILS=juan.garcia@cofinet.com.au

# Dominios de correo permitidos. Vacio = sin restriccion por dominio.
ALLOWED_EMAIL_DOMAINS=cofinet.com.au

# --- Microsoft Entra ID (solo si AUTH_MODE incluye 'entra') ------------------
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
