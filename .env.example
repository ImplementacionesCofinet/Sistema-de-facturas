# =============================================================================
# Cofinet - Sistema de facturas. Copie este archivo como .env y complete.
# =============================================================================

# --- Base de datos -----------------------------------------------------------
# PostgreSQL. En Supabase use la cadena del "Connection pooler" (puerto 6543).
DATABASE_URL=postgresql://usuario:clave@localhost:5432/cofinet_facturas

# --- Aplicacion --------------------------------------------------------------
# URL publica. Debe coincidir con el redirect URI registrado en Azure.
APP_URL=http://localhost:3000

# Secreto para firmar la cookie de sesion. Generelo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=cambie-este-valor-por-uno-aleatorio-de-al-menos-32-caracteres

# --- Inicio de sesion --------------------------------------------------------
# local -> correo y contrasena guardados en esta base de datos (red interna,
#          sin HTTPS ni salida a internet). Es lo recomendado on-premise.
# entra -> Microsoft 365. Exige HTTPS y que el servidor alcance internet.
# ambos -> se ofrecen las dos opciones.
# Si se deja vacio: 'entra' cuando hay credenciales de Microsoft, 'local' si no.
AUTH_MODE=local

# Solo para AUTH_MODE local: control de intentos fallidos.
MAX_INTENTOS_LOGIN=5
MINUTOS_BLOQUEO_LOGIN=15

# --- Microsoft Entra ID (Microsoft 365) --------------------------------------
# Solo si AUTH_MODE incluye 'entra'.
# Portal de Azure > Microsoft Entra ID > Registros de aplicaciones.
# Redirect URI (tipo Web): {APP_URL}/api/auth/callback
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# --- Autorizacion ------------------------------------------------------------
# Correos que entran como ADMIN aunque la tabla aprobadores este vacia.
ADMIN_EMAILS=

# Dominios de correo permitidos, separados por coma. Vacio = todo el tenant.
ALLOWED_EMAIL_DOMAINS=cofinet.com.au,cofinetcomco.onmicrosoft.com

# --- Adjuntos ----------------------------------------------------------------
# local = carpeta en disco (requiere volumen persistente) | azure = Blob Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=soportes-facturas

# --- Desarrollo --------------------------------------------------------------
# Permite entrar con solo el correo, sin Microsoft. Nunca en produccion.
DEV_AUTH=false
